# Canonical copy lives at ~/.config/ghostty/config (same contents; track one or symlink).

# Ghostty config — replicated from ~/.config/kitty/kitty.conf (One Dark + keybinds)
# Reload: Ctrl+Shift+,  |  Edit: Ctrl+,

# --- Font (kitty: Iosevka 16) ---
font-family = Iosevka
font-size = 16

# --- Cursor (kitty: white, no blink) ---
cursor-color = #ffffff
cursor-style = block
cursor-style-blink = false

# --- Colors: One Dark (kitty foreground/background) ---
background = #282c34
foreground = #abb2bf
selection-background = #3e4451
selection-foreground = #abb2bf

# ANSI palette (kitty color0–color15)
palette = 0=#282c34
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#abb2bf
palette = 8=#596276
palette = 9=#be5046
palette = 10=#98c379
palette = 11=#d19a66
palette = 12=#61afef
palette = 13=#c678dd
palette = 14=#56b6c2
palette = 15=#5c6370

# --- Window / splits (kitty: padding 0, border colors) ---
window-padding-x = 0
window-padding-y = 0
split-divider-color = #3e4451
unfocused-split-opacity = 0.6

# --- Tabs / titlebar (Ghostty bar with close/min/max; no native OS titlebar) ---
window-decoration = client
gtk-titlebar = true
gtk-titlebar-style = tabs
window-theme = ghostty
window-titlebar-background = #22262d
window-titlebar-foreground = #5c6370
window-show-tab-bar = always

# --- Bell (kitty: audio + alert) ---
bell-features = audio,system,title

# --- Shell / cwd (kitty: new_window_with_cwd / new_tab_with_cwd) ---
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

shell-integration-features = no-cursor

# =============================================================================
# Keybinds — kitty_mod = Ctrl+Shift
# =============================================================================

keybind = ctrl+shift+b=scroll_page_up
keybind = ctrl+shift+f=scroll_page_down
keybind = ctrl+shift+enter=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+j=goto_split:previous
keybind = ctrl+shift+k=goto_split:next
keybind = ctrl+shift+up=move_tab:-1
keybind = ctrl+shift+down=move_tab:1
keybind = ctrl+shift+[=previous_tab
keybind = ctrl+shift+]=next_tab
keybind = ctrl+shift+left=move_tab:-1
keybind = ctrl+shift+right=move_tab:1
keybind = ctrl+shift+0=equalize_splits
keybind = ctrl+shift+9=new_split:down
keybind = ctrl+shift+8=new_split:right
keybind = ctrl+shift+equal=increase_font_size:2
keybind = ctrl+shift+plus=increase_font_size:2
keybind = ctrl+shift+minus=decrease_font_size:2
keybind = ctrl+shift+backspace=reset_font_size
keybind = ctrl+space=text:\x10
